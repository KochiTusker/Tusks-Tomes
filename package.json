{
  "name": "tusks-tomes",
  "version": "2.0.2",
  "private": true,
  "type": "module",
  "description": "Tusk's Tomes — local-first D&D session chronicler with multi-provider AI",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "cross-env NODE_ENV=production node dist-server/index.js",
    "test": "vitest run",
    "verify": "npm run typecheck && npm test && npm run uninstall:test && npm run audit:dev && node scripts/audit-security-contracts.mjs",
    "uninstall:test": "node scripts/uninstall.test.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "smoke-test": "node scripts/smoke-test.mjs",
    "safety-probe": "node scripts/safety-probe.mjs",
    "hybrid-validate": "node scripts/safety-probe/hybrid-validate.mjs",
    "docs:tone": "node scripts/docs-tone.mjs",
    "site:build": "node scripts/site/build-site.mjs",
    "site:card": "node scripts/site/make-social-card.mjs",
    "site:preview": "node scripts/site/build-site.mjs && node scripts/site/preview-site.mjs",
    "site:audit": "node scripts/site/audit-site.mjs",
    "names:check": "node scripts/rotate-names.mjs --check",
    "names:verify": "node scripts/rotate-names.mjs --verify",
    "names:rotate": "node scripts/rotate-names.mjs --apply && npm run typecheck && npm test",
    "site:publish": "node scripts/site/build-site.mjs && node scripts/site/publish-site.mjs",
    "audit:tree": "node scripts/audit-current-tree.mjs",
    "audit:dev": "node scripts/audit-current-tree.mjs --dev-mode",
    "audit:history": "node scripts/audit-history.mjs",
    "audit:contracts": "node scripts/audit-security-contracts.mjs",
    "security:check": "npm run typecheck && npm test && npm audit --audit-level=moderate && npm run audit:dev && npm run audit:contracts",
    "setup": "node scripts/setup/check-deps.mjs",
    "whisper:setup": "node scripts/whisper/run-setup.mjs",
    "whisper:setup:windows": "powershell -ExecutionPolicy Bypass -File scripts/whisper/setup.ps1",
    "whisper:setup:posix": "bash scripts/whisper/setup.sh",
    "uninstall": "node scripts/uninstall.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@google/genai": "^0.14.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-progress": "^1.1.0",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tabs": "^1.1.1",
    "@types/adm-zip": "^0.5.8",
    "@types/turndown": "^5.0.6",
    "adm-zip": "^0.6.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "docx": "^9.6.1",
    "double-metaphone": "^2.0.1",
    "env-paths": "^3.0.0",
    "express": "^4.21.1",
    "fastest-levenshtein": "^1.0.16",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^0.460.0",
    "mammoth": "^1.8.0",
    "motion": "^11.11.17",
    "multer": "^2.1.1",
    "openai": "^4.104.0",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^9.1.0",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^1.7.0",
    "tailwind-merge": "^2.5.4",
    "turndown": "^7.2.4"
  },
  "overrides": {
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.9.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "cross-env": "^7.0.3",
    "jsdom": "^29.1.1",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "tw-animate-css": "^1.0.0",
    "typescript": "^5.6.3",
    "unified": "^11.0.5",
    "vite": "^6.0.0",
    "vitest": "^4.1.6"
  }
}

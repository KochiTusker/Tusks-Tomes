        "Passage 9112285b9dc5: a sentry fell from the wall of Place-Delta.",
      ],
      "jests": [
        "Passage 9112285b9dc5: PC-Beta forgot the rope again.",
      ],
      "quotes": [
        {
          "context": "Before the gate.",
          "kind": "funny",
          "line": "We hold the line, 9112285b9dc5.",
          "speaker": "PC-Alpha",
        },
        {
          "exchange": [
            {
              "line": "You were warned, 9112285b9dc5.",
              "speaker": "NPC-Gamma",
            },
            {
              "line": "And yet here we are.",

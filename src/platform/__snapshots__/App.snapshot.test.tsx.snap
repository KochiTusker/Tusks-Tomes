exports[`audio add-on absent, everything configured > Tome of Lore: each section, opened > Tome of Lore > Names & corrections 1`] = `
"  [summary "Names & correctionsFix names transcription mishears, and map speakers to characters." open] Names & correctionsFix names transcription mishears, and map speakers to characters.
  Glossary
  Campaign-specific corrections applied during grounding. Safe replacements run deterministically before any AI call; contextual hints are injected into the AI prompt for case-by-case judgement.
  [button "Save" disabled]
  Safe Replacements
  Unambiguous fixes. The wrong form is never a real word. Matched case-insensitively as a whole word.
  [button "Add rule"]
  [textbox value="delter" placeholder="from (mistranscription)"] → [textbox value="Place-Delta" placeholder="to (canonical)"] [button "Remove rule"]
  [textbox value="echo guild" placeholder="from (mistranscription)"] → [textbox value="Faction-Echo" placeholder="to (canonical)"] [button "Remove rule"]
  Contextual Hints
  For cases where the wrong form IS a real word. The AI decides per-occurrence based on your notes.
  [button "Add hint"]
  Canonical
  [textbox "Canonical" value="PC-Alpha" placeholder="e.g. Az"]
  Common mishears (comma separated)
  [textbox "Common mishears (comma separated)" value="alpha" placeholder="as, Asz, Aza"]
  [button "Remove hint"]
  Notes (when to apply)
  [textbox "Notes (when to apply)" value="The first player character." placeholder="REPLACE only when …; DO NOT REPLACE when …"]
  Speakers
  Map speaker IDs to player and character names. When you upload a Craig zip the speaker IDs are populated automatically from the per-track filenames; you fill in the player and character names. The transcriber uses this to tag each line with the speaker.
  [button "Save" disabled]
  [button "Add speaker"]
  Track: Handle-One
  [button "Remove speaker"]
  Speaker ID
  [textbox "Speaker ID" value="speaker-1" placeholder="Craig speaker ID or any unique handle"]
  Track display name
  [textbox "Track display name" value="Handle-One" placeholder="wyldfyre_dm"]
  Player name
  [textbox "Player name" value="Player-One" placeholder="Wyldfyre"]
  Character name
  [textbox "Character name" value="PC-Alpha" placeholder="Ottilie"]
  Track: Handle-Two
  [button "Remove speaker"]
  Speaker ID
  [textbox "Speaker ID" value="speaker-2" placeholder="Craig speaker ID or any unique handle"]
  Track display name
  [textbox "Track display name" value="Handle-Two" placeholder="wyldfyre_dm"]
  Player name
  [textbox "Player name" value="Player-Two" placeholder="Wyldfyre"]
  Character name
  [textbox "Character name" value="PC-Bravo" placeholder="Ottilie"]"
`;


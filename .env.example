# =============================================================================
# Tusk's Tomes — environment configuration
# =============================================================================
#
# Every key in this file is OPTIONAL. The app works without a single one of
# them: launch it, go to Settings → API Keys, and paste any provider key
# directly into the UI. Keys you paste in-app are encrypted at rest in the
# platform configDir (machine-bound scrypt key — never readable from another
# machine even if exfiltrated).
#
# This .env file exists as a convenience for two scenarios:
#   1. You'd rather edit a file than click around the UI.
#   2. You want the app to auto-seed its encrypted keystore from environment
#      variables on first run (handy for CI / container deploys).
#
# WARNING: anything with a VITE_ prefix is inlined into the browser bundle
# by Vite. This app is intended for LOCAL USE ONLY. Do not deploy a built
# bundle publicly with real VITE_* keys in scope.

# ----- Cloud LLM API keys (any one is enough) -----
#
# All four are read on first boot. If providers.enc doesn't yet exist, the
# server seeds the encrypted keystore from whichever of these are set, then
# tells you which slots were populated. After that the in-app Settings tab
# is the source of truth — env-var changes won't override a stored key.

# Google Gemini — billing-enabled project key (preferred; required for
# Gemini 3.x models). Get one at https://aistudio.google.com/apikey.
PAID_GEMINI_API_KEY=

# Google Gemini — optional free-tier fallback for non-quota errors. Leave
# blank if you only have one key. Same source as PAID_GEMINI_API_KEY but
# scoped to a non-billing project.
VITE_GEMINI_API_KEY=

# Anthropic Claude — get a key at https://console.anthropic.com.
ANTHROPIC_API_KEY=

# OpenAI — get a key at https://platform.openai.com/api-keys.
OPENAI_API_KEY=

# Express server port (also serves the SPA via Vite middleware in dev).
PORT=5173

# ---- OPTIONAL: model overrides ----
# Defaults are gemini-2.5-pro (Pro) and gemini-2.5-flash (Flash) — these
# are stable and broadly available. To use Gemini 3.x or any other model:
#
#   1. Start the program and click "Check available models" on the
#      Chronicle tab to see the exact model IDs your key supports.
#   2. Copy the IDs you want into VITE_MODEL_PRO / VITE_MODEL_FLASH below.
#   3. Restart the program.
#
# VITE_MODEL_PRO=gemini-2.5-pro
# VITE_MODEL_FLASH=gemini-2.5-flash

# ---- OPTIONAL: max output tokens per call ----
# Default is 32768. Gemini 2.5 Pro/Flash both support up to 65536. Raise
# this if a chunk's output is hitting MAX_TOKENS (the error card will tell
# you). Lower it only if you want to fail fast on bloated outputs.
# VITE_MAX_OUTPUT_TOKENS=32768

# ---- OPTIONAL: session audio storage directory ----
# By default each uploaded session's audio + transcripts live under
# %LOCALAPPDATA%\tusks-tomes\Data\sessions (Windows) or the platform
# equivalent. Multi-GB Craig FLAC files can fill up a small system drive
# fast. Set this to keep them on a roomier drive — relative paths resolve
# against the repo root.
#
# Examples:
#   TUSKS_SESSIONS_DIR=./sessions               # next to the repo
#   TUSKS_SESSIONS_DIR=D:\TusksTomes\sessions   # somewhere on D:
#
# If you change this AFTER running real sessions, the old sessions stay
# at the previous path — copy/move them manually or just start fresh.
# TUSKS_SESSIONS_DIR=

# ---- OPTIONAL: Tusk's Vault pairing path ----
# Tusk's Tomes auto-detects a sibling checkout of the companion project
# Tusk's Vault (https://github.com/KochiTusker/tusks-vault) and lets
# you push finished chronicles into Vault's Lore folder with one click.
# By default we look at the parent directory for a folder named
# "tusks-vault", "Tusks-Vault", or "tusks_vault". Set this if your
# Vault checkout lives somewhere else.
#
# Examples:
#   TUSKS_VAULT_DIR=../tusks-vault                  # explicit sibling
#   TUSKS_VAULT_DIR=D:\Projects\tusks-vault          # absolute path
# TUSKS_VAULT_DIR=

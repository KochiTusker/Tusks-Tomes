exports[`POST /api/claude-code/generate > pins spawn shape and responses for every outcome 1`] = `
[
  {
    "case": "success (default model)",
    "response": {
      "body": {
        "costUsd": 0.0123,
        "text": "Place-Delta lay quiet.",
        "usage": {
          "inputTokens": 11,
          "outputTokens": 7,
        },
      },
      "contentType": "application/json; charset=utf-8",
      "status": 200,
    },
    "spawned": [
      {
        "args": [
          "-p",
          "--output-format",
          "json",
          "--model",
          "sonnet",
        ],
        "command": "claude",
        "cwd": "<TMP>/ostmp/tusks-tomes-claude-sandbox",
        "envInheritsPath": true,
        "envKeys": [
          "OPENAI_API_BASE",
          "OPENAI_API_KEY",
          "OPENAI_BASE_URL",
          "TT_GOLDEN_KEEP",
        ],
        "envPassed": true,
        "killed": false,
        "shellIsWin32": true,
        "stdin": "SYSTEM: be brief

USER: describe Place-Delta",
        "stdinEnded": true,
        "stdio": [
          "pipe",
          "pipe",
          "pipe",
        ],
      },
    ],
  },
  {
    "case": "success (explicit model, maxOutputTokens ignored)",
